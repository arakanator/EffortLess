<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EffortLess.App">
    
 <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="PlayerShellBrush" Color="#18191C"/>
            <SolidColorBrush x:Key="PlayerVideoBrush" Color="#101113"/>
            <SolidColorBrush x:Key="PlayerTextBrush" Color="#DADCE1"/>
            <SolidColorBrush x:Key="PlayerTitleBrush" Color="#BABDC4"/>
            <SolidColorBrush x:Key="PlayerSecondaryBrush" Color="#989CA5"/>
            <SolidColorBrush x:Key="PlayerFocusBrush" Color="#AAB6C8"/>
            <SolidColorBrush x:Key="PlayerHoverBrush" Color="#2A2C31"/>
            <SolidColorBrush x:Key="PlayerPressedBrush" Color="#34373E"/>

            <!-- Keep the SDK Slider template and its range, pointer and focus semantics. -->
            <x:Double x:Key="SliderTrackThemeHeight">3</x:Double>
            <x:Double x:Key="SliderHorizontalThumbWidth">8</x:Double>
            <x:Double x:Key="SliderHorizontalThumbHeight">8</x:Double>
            <x:Double x:Key="SliderInnerThumbWidth">8</x:Double>
            <x:Double x:Key="SliderInnerThumbHeight">8</x:Double>
            <x:Double x:Key="SliderPreContentMargin">14.5</x:Double>
            <x:Double x:Key="SliderPostContentMargin">14.5</x:Double>
            <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#DADCE1"/>
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#F0F1F4"/>
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#BEC7D4"/>
            <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#555962"/>
            <SolidColorBrush x:Key="SliderTrackFill" Color="#3B3E45"/>
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#4A4E56"/>
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#4A4E56"/>
            <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="#292B30"/>
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#BEC7D4"/>
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#DADCE1"/>
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#DADCE1"/>
            <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#555962"/>
        </ResourceDictionary>
        <!-- Respect Windows contrast colors while retaining the same shell and controls. -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="PlayerShellBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="PlayerVideoBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="PlayerTextBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="PlayerTitleBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="PlayerSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="PlayerFocusBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="PlayerHoverBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="PlayerPressedBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <x:Double x:Key="PlayerBrandLabelMinimumWidth">500</x:Double>
    <x:Double x:Key="PlayerHeaderHeight">56</x:Double>
    <x:Double x:Key="PlayerTransportHeight">88</x:Double>
    <x:Double x:Key="PlayerIconSize">16</x:Double>
    <x:Double x:Key="PlayerPlayIconSize">18</x:Double>
    <x:Double x:Key="PlayerInfoIconSize">14</x:Double>
    <x:Double x:Key="PlayerTitleFontSize">13</x:Double>
    <x:Double x:Key="PlayerTimeFontSize">11</x:Double>
    <x:Double x:Key="PlayerControlSize">32</x:Double>
    <x:Double x:Key="PlayerVolumeWidth">72</x:Double>
    <x:Double x:Key="PlayerSmallSpacing">8</x:Double>
    <x:Double x:Key="PlayerControlSpacing">14</x:Double>
    <x:Double x:Key="PlayerVolumeSpacing">10</x:Double>
    <x:Double x:Key="PlayerQueueWidth">260</x:Double>
    <x:Double x:Key="PlayerCompactWidth">440</x:Double>
    <x:Double x:Key="PlayerMinimumWidth">440</x:Double>
    <x:Double x:Key="PlayerMinimumHeight">260</x:Double>
    <x:Double x:Key="PlayerNarrowWidth">600</x:Double>
    <x:Double x:Key="PlayerNarrowVolumeWidth">48</x:Double>
    <x:Double x:Key="PlayerQueueMinimumWindowWidth">700</x:Double>
    <x:Double x:Key="PlayerDetailsMinWidth">190</x:Double>
    <x:Double x:Key="PlayerDetailsMaxWidth">360</x:Double>
    <x:Double x:Key="PlayerEmptyTitleFontSize">18</x:Double>
    <x:Double x:Key="PlayerNoticesHeight">280</x:Double>
    <CornerRadius x:Key="PlayerDetailsCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="PlayerButtonCornerRadius">5</CornerRadius>
    <Thickness x:Key="PlayerFocusThickness">1</Thickness>
    <Thickness x:Key="PlayerSliderFocusMargin">-3,0,-3,0</Thickness>
    <Thickness x:Key="PlayerHeaderPadding">8,0,0,0</Thickness>
    <Thickness x:Key="PlayerTransportPadding">12,0</Thickness>
    <Thickness x:Key="PlayerDetailsPadding">16</Thickness>
    <Duration x:Key="PlayerHoverDuration">0:0:0.08</Duration>
    <x:Double x:Key="PlayerTransportTransitionMilliseconds">220</x:Double>

    <local:ActiveLibraryBrushConverter x:Key="ActiveLibraryBrush"/>
    <SolidColorBrush x:Key="PlayerTransparentBrush" Color="Transparent"/>
    <x:Double x:Key="PlayerGlowFalloff">0.65</x:Double>
    <x:Double x:Key="PlayerBackdropOpacity">0.90</x:Double>
    <SolidColorBrush x:Key="PlayerPanelBrush" Color="#111E26"/>
    <SolidColorBrush x:Key="PlayerElevatedPanelBrush" Color="#172A34"/>
    <SolidColorBrush x:Key="PlayerBorderBrush" Color="#304957"/>
    <SolidColorBrush x:Key="PlayerAccentBrush" Color="#35D4EA"/>
    <SolidColorBrush x:Key="PlayerAccentGlowBrush" Color="#1635D4EA"/>
    <SolidColorBrush x:Key="PlayerSelectedBrush" Color="#2035D4EA"/>
    <SolidColorBrush x:Key="PlayerSeparatorBrush" Color="#304957"/>
    <x:Double x:Key="PlayerNavigationHeight">40</x:Double>
    <Thickness x:Key="PlayerNavigationPadding">10,4</Thickness>
    <x:Double x:Key="PlayerInfoWidth">248</x:Double>
    <x:Double x:Key="PlayerInfoThumbnailHeight">132</x:Double>
    <x:Double x:Key="PlayerWideWidth">1180</x:Double>
    <x:Double x:Key="PlayerSettingsWidth">280</x:Double>
    <x:Double x:Key="PlayerSettingsMaxHeight">560</x:Double>
    <x:Double x:Key="PlayerThumbnailWidth">56</x:Double>
    <x:Double x:Key="PlayerThumbnailHeight">42</x:Double>
    <x:Double x:Key="PlayerBrandFontSize">19</x:Double>
    <x:Double x:Key="PlayerSectionFontSize">15</x:Double>
    <x:Double x:Key="PlayerPlaySize">46</x:Double>
    <Thickness x:Key="PlayerWorkspacePadding">8,0,8,8</Thickness>
    <Thickness x:Key="PlayerTitleMargin">16,0,0,0</Thickness>
    <Thickness x:Key="PlayerListItemPadding">6</Thickness>
    <Thickness x:Key="PlayerListItemMargin">0,2</Thickness>
    <Thickness x:Key="PlayerTransportMargin">0,8,0,0</Thickness>
    <Thickness x:Key="PlayerPanelPadding">10</Thickness>
    <CornerRadius x:Key="PlayerPanelCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="PlayerPlayCornerRadius">24</CornerRadius>
    <Thickness x:Key="PlayerPanelBorderThickness">1</Thickness>
    <Style x:Key="PlayerPanel" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PlayerPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource PlayerBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource PlayerPanelBorderThickness}"/>
        <Setter Property="CornerRadius" Value="{StaticResource PlayerPanelCornerRadius}"/>
        <Setter Property="Padding" Value="{StaticResource PlayerPanelPadding}"/>
    </Style>
    <Style x:Key="PlayerBrandLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display"/>
        <Setter Property="FontSize" Value="{StaticResource PlayerBrandFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource PlayerTextBrush}"/>
    </Style>
    <Style x:Key="PlayerSectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
        <Setter Property="FontSize" Value="{StaticResource PlayerSectionFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource PlayerTextBrush}"/>
    </Style>
    <Style x:Key="PlayerLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
        <Setter Property="FontSize" Value="{StaticResource PlayerTitleFontSize}"/>
        <Setter Property="Foreground" Value="{ThemeResource PlayerSecondaryBrush}"/>
    </Style>
    <Style TargetType="FontIcon"><Setter Property="FontFamily" Value="Segoe Fluent Icons"/></Style>
    <Style TargetType="FlyoutPresenter">
        <Setter Property="Background" Value="{ThemeResource PlayerPanelBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource PlayerTextBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource PlayerBorderBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource PlayerPanelCornerRadius}"/>
    </Style>
    <Style TargetType="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{ThemeResource PlayerShellBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource PlayerTextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
        <Setter Property="FontSize" Value="{StaticResource PlayerTitleFontSize}"/>
    </Style>


    <Style x:Key="PlayerSlider" TargetType="Slider" BasedOn="{StaticResource DefaultSliderStyle}">
        <!-- Time remains visible beside the seek bar; avoid detached numeric
             thumb tips surviving a native fullscreen/presenter transition. -->
        <Setter Property="IsThumbToolTipEnabled" Value="False"/>
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Height" Value="{StaticResource PlayerControlSize}"/>
        <Setter Property="MinHeight" Value="{StaticResource PlayerControlSize}"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="FocusVisualMargin" Value="{StaticResource PlayerSliderFocusMargin}"/>
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource PlayerFocusBrush}"/>
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource PlayerFocusThickness}"/>
        <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
    </Style>

    <Style x:Key="PlayerIconButton" TargetType="Button">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="{StaticResource PlayerControlSize}"/>
        <Setter Property="Height" Value="{StaticResource PlayerControlSize}"/>
        <Setter Property="MinWidth" Value="{StaticResource PlayerControlSize}"/>
        <Setter Property="MinHeight" Value="{StaticResource PlayerControlSize}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="{ThemeResource PlayerTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="{StaticResource PlayerButtonCornerRadius}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="FocusVisualMargin" Value="0"/>
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource PlayerFocusBrush}"/>
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource PlayerFocusThickness}"/>
        <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="ButtonRoot" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="{StaticResource PlayerHoverDuration}"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters><Setter Target="HoverSurface.Opacity" Value="1"/></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverSurface.Opacity" Value="1"/>
                                        <Setter Target="HoverSurface.Background" Value="{ThemeResource PlayerPressedBrush}"/>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.75"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters><Setter Target="ButtonRoot.Opacity" Value="0.35"/></VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                        <Border x:Name="HoverSurface" Opacity="0" Background="{ThemeResource PlayerHoverBrush}" CornerRadius="{TemplateBinding CornerRadius}"/>
                        <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlayerNavigationButton" TargetType="Button" BasedOn="{StaticResource PlayerIconButton}">
        <Setter Property="Height" Value="{StaticResource PlayerNavigationHeight}"/>
        <Setter Property="MinHeight" Value="{StaticResource PlayerNavigationHeight}"/>
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="{StaticResource PlayerNavigationPadding}"/>
    </Style>
    <Style x:Key="PlayerPlayButton" TargetType="Button" BasedOn="{StaticResource PlayerIconButton}">
        <Setter Property="Width" Value="{StaticResource PlayerPlaySize}"/>
        <Setter Property="Height" Value="{StaticResource PlayerPlaySize}"/>
        <Setter Property="CornerRadius" Value="{StaticResource PlayerPlayCornerRadius}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource PlayerAccentBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource PlayerPanelBorderThickness}"/>
        <Setter Property="Background" Value="{ThemeResource PlayerSelectedBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource PlayerAccentBrush}"/>
    </Style>
</ResourceDictionary>
